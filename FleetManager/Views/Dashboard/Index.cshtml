@model FleetManager.Models.ViewModels.DashboardPaginaViewModel
@{
    Layout = null;
    ViewData["Title"] = "Dashboard";
}
<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fondazione Simonini | Dashboard</title>
    <link rel="stylesheet" href="~/css/fleet.css" asp-append-version="true" />
</head>
<body>
    <div id="appShell">
        <header>
            <div class="header-logo-container">
                <img src="https://www.fondazionesimonini.it/imgs/logo.png" alt="Fondazione Simonini" style="height: 52px;">
                <div class="header-user">@Model.NomeUtenteCorrente @(Model.EAdmin ? "| Admin" : "| Utente")</div>
            </div>
            <div class="header-title-center">DASHBOARD</div>
            <div class="header-buttons">
                @if (Model.EAdmin)
                {
                    <details class="debug-menu">
                        <summary>Debug</summary>
                        <div class="debug-dropdown server-dropdown">
                            <form asp-action="RipristinaDemo" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="urlRitorno" value="@Model.UrlRitorno" />
                                <button type="submit">Ripristina Demo</button>
                            </form>
                            <form asp-action="SvuotaDatiDemo" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="urlRitorno" value="@Model.UrlRitorno" />
                                <button type="submit">Svuota Dati</button>
                            </form>
                        </div>
                    </details>
                    <a class="header-link-button" asp-action="Crea" asp-route-urlRitorno="@Model.UrlRitorno">Aggiungi Auto</a>
                }
                <a class="header-link-button" asp-controller="Account" asp-action="Logout">Logout</a>
            </div>
        </header>

        <div class="container">
            @if (!string.IsNullOrWhiteSpace(Model.MessaggioOperazione))
            {
                <div class="status-box" style="display:block;">@Model.MessaggioOperazione</div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.MessaggioErrore))
            {
                <div class="status-box" data-tone="error" style="display:block;">@Model.MessaggioErrore</div>
            }

            <div class="toolbar-note">
                <strong>@Model.TotaleVeicoli @(Model.TotaleVeicoli == 1 ? "veicolo" : "veicoli")</strong>
            </div>

            @* Filtri semplici passati in GET: il codice resta facile da seguire. *@
            <details class="search-panel" @(Model.Filtri.CiSonoFiltriAttivi ? "open" : null)>
                <summary class="search-summary">Ricerca avanzata</summary>
                <form asp-action="Index" method="get" class="search-grid">
                    <div class="search-field">
                        <label asp-for="Filtri.Ricerca">Ricerca</label>
                        <input asp-for="Filtri.Ricerca" placeholder="Modello, targa, stato, gruppo, carburante" />
                    </div>
                    <div class="search-field">
                        <label asp-for="Filtri.Gruppo">Gruppo</label>
                        <select asp-for="Filtri.Gruppo">
                            <option value="">Tutti i gruppi</option>
                            <option value="FONDAZIONE SETTORE-1">FONDAZIONE SETTORE-1</option>
                            <option value="FONDAZIONE SETTORE-2">FONDAZIONE SETTORE-2</option>
                            <option value="FONDAZIONE SETTORE-3">FONDAZIONE SETTORE-3</option>
                        </select>
                    </div>
                    <div class="search-field">
                        <label asp-for="Filtri.Stato">Stato</label>
                        <select asp-for="Filtri.Stato">
                            <option value="">Tutti gli stati</option>
                            <option value="non in uso">Non in uso</option>
                            <option value="in uso">In uso</option>
                            <option value="in richiesta manutenzione">In richiesta manutenzione</option>
                            <option value="in manutenzione">In manutenzione</option>
                        </select>
                    </div>
                    <div class="search-field">
                        <label asp-for="Filtri.Assegnatario">Assegnatario</label>
                        <input asp-for="Filtri.Assegnatario" placeholder="Nome assegnatario" />
                    </div>
                    <div class="search-field">
                        <label asp-for="Filtri.LivelloCarburante">Carburante</label>
                        <select asp-for="Filtri.LivelloCarburante">
                            <option value="">Tutti i livelli</option>
                            <option value="2">Alto</option>
                            <option value="1">Medio</option>
                            <option value="0">Riserva</option>
                        </select>
                    </div>
                    <div class="search-actions">
                        <button type="submit" class="btn-filter">Filtra</button>
                        <a asp-action="Index" class="btn-filter btn-filter-secondary">Pulisci</a>
                    </div>
                </form>
            </details>

            <div class="summary-strip">
                <div class="summary-card"><span>Veicoli visibili</span><strong>@Model.TotaleVeicoli</strong></div>
                <div class="summary-card"><span>In uso</span><strong>@Model.TotaleInUso</strong></div>
                <div class="summary-card"><span>Manutenzione</span><strong>@Model.TotaleManutenzione</strong></div>
            </div>

            @if (!Model.Veicoli.Any())
            {
                <div class="empty-state">Nessun veicolo trovato con i filtri correnti.</div>
            }
            else
            {
                foreach (var gruppo in Model.Veicoli.GroupBy(veicolo => veicolo.Gruppo))
                {
                    <h3 class="group-header title-@gruppo.Key.ToLowerInvariant().Replace(" ", "-")">@gruppo.Key</h3>

                    <div class="cars-grid">
                        @foreach (var veicolo in gruppo)
                        {
                            <div class="car-card card-@veicolo.Gruppo.ToLowerInvariant().Replace(" ", "-")">
                                <div class="car-image" style="background-image:url('@veicolo.UrlImmagine')"></div>
                                <div class="car-info">
                                    <div class="car-model">@veicolo.Modello</div>
                                    <div class="car-brand status-@veicolo.Stato.Replace(" ", "-")">@veicolo.Stato</div>
                                    <div class="car-targa">Targa: @veicolo.Targa</div>
                                    <div class="car-detail"><span>Assegnatario:</span><strong>@(string.IsNullOrWhiteSpace(veicolo.NomeAssegnatario) ? "-" : veicolo.NomeAssegnatario)</strong></div>
                                    <div class="car-detail"><span>KM:</span><strong>@veicolo.Chilometraggio.ToString("N0", new System.Globalization.CultureInfo("it-IT"))</strong></div>
                                    <div class="car-detail"><span>Carburante:</span><strong>@(veicolo.LivelloCarburante == 2 ? "Alto" : veicolo.LivelloCarburante == 1 ? "Medio" : "Riserva")</strong></div>

                                    <details class="card-details">
                                        <summary>Scadenze</summary>
                                        <div class="card-deadlines">
                                            <div><span>Revisione</span><strong>@FormattaPeriodo(veicolo.RevisioneInizio, veicolo.RevisioneScadenza)</strong></div>
                                            <div><span>Bollo</span><strong>@FormattaPeriodo(veicolo.BolloInizio, veicolo.BolloScadenza)</strong></div>
                                            <div><span>Tagliando</span><strong>@FormattaPeriodo(veicolo.TagliandoInizio, veicolo.TagliandoScadenza)</strong></div>
                                            <div><span>Assicurazione</span><strong>@FormattaPeriodo(veicolo.AssicurazioneInizio, veicolo.AssicurazioneScadenza)</strong></div>
                                        </div>
                                    </details>

                                    <div class="card-actions">
                                        @if (veicolo.PuoUsareOra)
                                        {
                                            <form asp-action="UsaOra" method="post" class="inline-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@veicolo.Id" />
                                                <input type="hidden" name="urlRitorno" value="@Model.UrlRitorno" />
                                                <button type="submit" class="btn-use-now btn-@veicolo.Gruppo.ToLowerInvariant().Replace(" ", "-")">
                                                    @(veicolo.Stato == "in uso" ? "Smetti di usare" : "Utilizza ora")
                                                </button>
                                            </form>
                                        }

                                        @if (veicolo.PuoSegnalareManutenzione)
                                        {
                                            <form asp-action="SegnalaManutenzione" method="post" class="inline-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@veicolo.Id" />
                                                <input type="hidden" name="urlRitorno" value="@Model.UrlRitorno" />
                                                <button type="submit" class="btn-secondary-action">Segnala manutenzione</button>
                                            </form>
                                        }

                                        @if (veicolo.PuoApprovareManutenzione)
                                        {
                                            <form asp-action="ApprovaManutenzione" method="post" class="inline-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@veicolo.Id" />
                                                <input type="hidden" name="urlRitorno" value="@Model.UrlRitorno" />
                                                <button type="submit" class="btn-secondary-action">Metti in manutenzione</button>
                                            </form>
                                        }

                                        <a class="btn-edit btn-@veicolo.Gruppo.ToLowerInvariant().Replace(" ", "-")"
                                           asp-action="Modifica"
                                           asp-route-id="@veicolo.Id"
                                           asp-route-urlRitorno="@Model.UrlRitorno">
                                            @(veicolo.PuoModificare ? "Modifica" : "Dettagli")
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
</body>
</html>

@functions {
    private string FormattaPeriodo(DateTime? dataInizio, DateTime? dataFine)
    {
        if (!dataInizio.HasValue && !dataFine.HasValue)
        {
            return "-";
        }

        var inizio = dataInizio?.ToString("dd/MM/yyyy") ?? "-";
        var fine = dataFine?.ToString("dd/MM/yyyy") ?? "-";
        return inizio + " - " + fine;
    }
}
