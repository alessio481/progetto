@model FleetManager.Models.ViewModels.DashboardPaginaViewModel
@{
    Layout = null;
    ViewData["Title"] = "Dashboard";
    var messaggioOperazioneJson = System.Text.Json.JsonSerializer.Serialize(Model.MessaggioOperazione);
    var messaggioErroreJson = System.Text.Json.JsonSerializer.Serialize(Model.MessaggioErrore);
}
<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fondazione Simonini | Dashboard</title>
    <link rel="stylesheet" href="~/css/fleet.css" asp-append-version="true" />
</head>
<body>
    <div id="appShell">
        <header>
            <div class="header-logo-container">
                <img src="https://www.fondazionesimonini.it/imgs/logo.png" alt="Fondazione Simonini" style="height: 62px;">
                <div>
                    <div class="header-user">@Model.NomeUtenteCorrente | @EtichettaRuolo(Model.EAdmin)</div>
                    @if (!Model.EAdmin)
                    {
                        <div class="header-drive-pill">
                            <span>Totale guida</span>
                            <strong>@FormattaSecondi(Model.TempoGuidaSecondi)</strong>
                        </div>
                    }
                </div>
            </div>
            <div class="header-title-center">DASHBOARD</div>
            <div class="header-buttons">
                @if (Model.EAdmin)
                {
                    <details class="debug-menu">
                        <summary>Admin</summary>
                        <div class="debug-dropdown server-dropdown">
                            <a asp-action="TempiGuidaUtenti">Tempi guida</a>
                            <a asp-action="CreaUtente">Aggiungi utente</a>
                            <a asp-action="Crea">Aggiungi auto</a>
                            <form asp-action="RipristinaDemo" method="post">
                                <button type="submit">Ripristina Demo</button>
                            </form>
                            <form asp-action="SvuotaDatiDemo" method="post">
                                <button type="submit">Svuota Dati</button>
                            </form>
                        </div>
                    </details>
                }
                <a class="header-link-button" asp-controller="Account" asp-action="Logout">Logout</a>
            </div>
        </header>

        <div class="container">
            <div class="toolbar-note">
                <strong>@Model.TotaleVeicoli @TestoVeicoli(Model.TotaleVeicoli)</strong>
            </div>

            @* Filtri semplici passati in GET: il codice resta facile da seguire. *@
            <details class="search-panel" @AttributoAperto(Model.FiltriRicerca.CiSonoFiltriAttivi)>
                <summary class="search-summary">Ricerca avanzata</summary>
                <form asp-action="Index" method="get" class="search-grid">
                    <div class="search-field">
                        <label asp-for="FiltriRicerca.Ricerca">Ricerca</label>
                        <input asp-for="FiltriRicerca.Ricerca" placeholder="Modello, targa, stato, gruppo, carburante" />
                    </div>
                    <div class="search-field">
                        <label asp-for="FiltriRicerca.Gruppo">Gruppo</label>
                        <select asp-for="FiltriRicerca.Gruppo">
                            <option value="">Tutti i gruppi</option>
                            <option value="1">FONDAZIONE SETTORE-1</option>
                            <option value="2">FONDAZIONE SETTORE-2</option>
                            <option value="3">FONDAZIONE SETTORE-3</option>
                        </select>
                    </div>
                    <div class="search-field">
                        <label asp-for="FiltriRicerca.Stato">Stato</label>
                        <select asp-for="FiltriRicerca.Stato">
                            <option value="">Tutti gli stati</option>
                            <option value="non in uso">Non in uso</option>
                            <option value="in uso">In uso</option>
                            <option value="in richiesta manutenzione">In richiesta manutenzione</option>
                            <option value="in manutenzione">In manutenzione</option>
                        </select>
                    </div>
                    <div class="search-field">
                        <label asp-for="FiltriRicerca.Assegnatario">Assegnatario</label>
                        <input asp-for="FiltriRicerca.Assegnatario" placeholder="Nome assegnatario" />
                    </div>
                    <div class="search-field">
                        <label asp-for="FiltriRicerca.LivelloCarburante">Carburante</label>
                        <select asp-for="FiltriRicerca.LivelloCarburante">
                            <option value="">Tutti i livelli</option>
                            <option value="2">Alto</option>
                            <option value="1">Medio</option>
                            <option value="0">Riserva</option>
                        </select>
                    </div>
                    <div class="search-actions">
                        <button type="submit" class="btn-filter">Filtra</button>
                        <a asp-action="Index" class="btn-filter btn-filter-secondary">Pulisci</a>
                    </div>
                </form>
            </details>

            <div class="summary-strip">
                <div class="summary-card"><span>Veicoli visibili</span><strong>@Model.TotaleVeicoli</strong></div>
                <div class="summary-card"><span>In uso</span><strong>@Model.TotaleInUso</strong></div>
                <div class="summary-card"><span>Manutenzione</span><strong>@Model.TotaleManutenzione</strong></div>
            </div>

            @if (!Model.SchedeVeicoli.Any())
            {
                <div class="empty-state">Nessun veicolo trovato con i filtri correnti.</div>
            }
            else
            {
                foreach (var gruppo in Model.SchedeVeicoli.GroupBy(veicolo => veicolo.Gruppo))
                {
                    <h3 class="group-header title-@ClasseCss(gruppo.Key)">@gruppo.Key</h3>

                    <div class="cars-grid">
                        @foreach (var veicolo in gruppo)
                        {
                            <div class="car-card card-@ClasseCss(veicolo.Gruppo)">
                                <div class="car-image" style="background-image:url('@veicolo.LinkImmagine')"></div>
                                <div class="car-info">
                                    <div class="car-model">@veicolo.Modello</div>
                                    <div class="car-status-row">
                                        <div class="car-brand status-@ClasseCss(veicolo.Stato)">@veicolo.Stato</div>
                                        @if (veicolo.MostraTimerGuida)
                                        {
                                            <strong class="status-live-time js-drive-time"
                                                    data-base-seconds="0"
                                                    data-start-unix="@veicolo.InizioGuidaUnix">
                                                00:00:00
                                            </strong>
                                        }
                                    </div>
                                    <div class="car-targa">Targa: @veicolo.Targa</div>
                                    <div class="car-detail"><span>Assegnatario:</span><strong>@NomeAssegnatario(veicolo.NomeAssegnatario)</strong></div>
                                    <div class="car-detail"><span>KM:</span><strong>@veicolo.Chilometraggio.ToString("N0", new System.Globalization.CultureInfo("it-IT"))</strong></div>
                                    <div class="car-detail"><span>Carburante:</span><strong>@EtichettaCarburante(veicolo.LivelloCarburante)</strong></div>

                                    <details class="card-details">
                                        <summary>Scadenze</summary>
                                        <div class="card-deadlines">
                                            <div><span>Revisione</span><strong>@FormattaPeriodo(veicolo.RevisioneInizio, veicolo.RevisioneScadenza)</strong></div>
                                            <div><span>Bollo</span><strong>@FormattaPeriodo(veicolo.BolloInizio, veicolo.BolloScadenza)</strong></div>
                                            <div><span>Tagliando</span><strong>@FormattaPeriodo(veicolo.TagliandoInizio, veicolo.TagliandoScadenza)</strong></div>
                                            <div><span>Assicurazione</span><strong>@FormattaPeriodo(veicolo.AssicurazioneInizio, veicolo.AssicurazioneScadenza)</strong></div>
                                        </div>
                                    </details>

                                    <div class="card-actions">
                                        @if (veicolo.PuoUsareOra)
                                        {
                                            <form asp-action="UsaOra" method="post" class="inline-form">
                                                <input type="hidden" name="id" value="@veicolo.IdVeicolo" />
                                                <button type="submit" class="btn-use-now btn-@ClasseCss(veicolo.Gruppo)">
                                                    @TestoPulsanteUso(veicolo.Stato)
                                                </button>
                                            </form>
                                        }

                                        @if (veicolo.PuoSegnalareManutenzione)
                                        {
                                            <form asp-action="SegnalaManutenzione" method="post" class="inline-form">
                                                <input type="hidden" name="id" value="@veicolo.IdVeicolo" />
                                                <button type="submit" class="btn-secondary-action">Segnala manutenzione</button>
                                            </form>
                                        }

                                        @if (veicolo.PuoApprovareManutenzione)
                                        {
                                            <form asp-action="ApprovaManutenzione" method="post" class="inline-form">
                                                <input type="hidden" name="id" value="@veicolo.IdVeicolo" />
                                                <button type="submit" class="btn-secondary-action">Metti in manutenzione</button>
                                            </form>
                                        }

                                        @if (veicolo.PuoTerminareManutenzione)
                                        {
                                            <form asp-action="TerminaManutenzione" method="post" class="inline-form">
                                                <input type="hidden" name="id" value="@veicolo.IdVeicolo" />
                                                <button type="submit" class="btn-secondary-action">Termina manutenzione</button>
                                            </form>
                                        }

                                        <a class="btn-edit btn-@ClasseCss(veicolo.Gruppo)"
                                           asp-action="Modifica"
                                           asp-route-id="@veicolo.IdVeicolo">
                                            @TestoPulsanteDettaglio(veicolo.PuoModificare)
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
    <script>
        const chiaveScrollDashboard = "dashboard-scroll";
        const messaggioOperazione = @Html.Raw(messaggioOperazioneJson);
        const messaggioErrore = @Html.Raw(messaggioErroreJson);

        function formattaSecondi(secondiTotali) {
            const ore = Math.floor(secondiTotali / 3600);
            const minuti = Math.floor((secondiTotali % 3600) / 60);
            const secondi = secondiTotali % 60;

            return String(ore).padStart(2, "0") + ":" +
                String(minuti).padStart(2, "0") + ":" +
                String(secondi).padStart(2, "0");
        }

        function aggiornaTempiGuida() {
            const unixAdesso = Math.floor(Date.now() / 1000);
            const elementi = document.querySelectorAll(".js-drive-time");

            for (const elemento of elementi) {
                const baseSeconds = Number(elemento.dataset.baseSeconds || "0");
                const startUnix = Number(elemento.dataset.startUnix || "0");
                let secondiTotali = baseSeconds;

                if (startUnix > 0) {
                    secondiTotali += Math.max(0, unixAdesso - startUnix);
                }

                elemento.textContent = formattaSecondi(secondiTotali);
            }
        }

        const scrollSalvato = sessionStorage.getItem(chiaveScrollDashboard);
        if (scrollSalvato) {
            window.scrollTo(0, Number(scrollSalvato));
        }

        window.addEventListener("scroll", function () {
            sessionStorage.setItem(chiaveScrollDashboard, String(window.scrollY));
        });

        aggiornaTempiGuida();
        window.setInterval(aggiornaTempiGuida, 1000);

        // L'alert parte alla fine, quando la pagina e' gia' pronta.
        if (messaggioErrore) {
            window.setTimeout(function () {
                window.alert(messaggioErrore);
            }, 0);
        } else if (messaggioOperazione) {
            window.setTimeout(function () {
                window.alert(messaggioOperazione);
            }, 0);
        }

    </script>
</body>
</html>

@functions {
    private string AttributoAperto(bool aperto)
    {
        if (aperto)
        {
            return "open";
        }

        return string.Empty;
    }

    private string EtichettaRuolo(bool eAdmin)
    {
        if (eAdmin)
        {
            return "Admin";
        }

        return "Utente";
    }

    private string TestoVeicoli(int totaleVeicoli)
    {
        if (totaleVeicoli == 1)
        {
            return "veicolo";
        }

        return "veicoli";
    }

    private string ClasseCss(string? testo)
    {
        if (string.IsNullOrWhiteSpace(testo))
        {
            return "vuoto";
        }

        return testo.Trim().ToLowerInvariant().Replace(" ", "-");
    }

    private string NomeAssegnatario(string? nomeAssegnatario)
    {
        if (string.IsNullOrWhiteSpace(nomeAssegnatario))
        {
            return "-";
        }

        return nomeAssegnatario;
    }

    private string EtichettaCarburante(int livelloCarburante)
    {
        if (livelloCarburante == 2)
        {
            return "Alto";
        }

        if (livelloCarburante == 1)
        {
            return "Medio";
        }

        return "Riserva";
    }

    private string TestoPulsanteUso(string stato)
    {
        if (stato == "in uso")
        {
            return "Smetti di usare";
        }

        return "Utilizza ora";
    }

    private string TestoPulsanteDettaglio(bool puoModificare)
    {
        if (puoModificare)
        {
            return "Modifica";
        }

        return "Dettagli";
    }

    private string FormattaPeriodo(DateTime? dataInizio, DateTime? dataFine)
    {
        if (!dataInizio.HasValue && !dataFine.HasValue)
        {
            return "-";
        }

        var inizio = "-";
        if (dataInizio.HasValue)
        {
            inizio = dataInizio.Value.ToString("dd/MM/yyyy");
        }

        var fine = "-";
        if (dataFine.HasValue)
        {
            fine = dataFine.Value.ToString("dd/MM/yyyy");
        }

        return inizio + " - " + fine;
    }

    private string FormattaSecondi(long secondiTotali)
    {
        var ore = secondiTotali / 3600;
        var minuti = (secondiTotali % 3600) / 60;
        var secondi = secondiTotali % 60;

        return ore.ToString("00") + ":" + minuti.ToString("00") + ":" + secondi.ToString("00");
    }
}
