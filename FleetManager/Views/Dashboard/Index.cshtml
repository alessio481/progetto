@model FleetManager.Models.ViewModels.DashboardIndexViewModel
@{
    Layout = null;
    ViewData["Title"] = "Dashboard";
}
<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fondazione Simonini | Dashboard</title>
    <link rel="stylesheet" href="~/css/fleet.css" asp-append-version="true" />
</head>
<body>
    <div id="appShell">
        <header>
            <div class="header-logo-container">
                <img src="https://www.fondazionesimonini.it/imgs/logo.png" alt="Fondazione Simonini" style="height: 52px;">
                <div class="header-user">@Model.CurrentUserName @(Model.IsAdmin ? "| Admin" : "| Utente")</div>
            </div>
            <div class="header-title-center">DASHBOARD</div>
            <div class="header-buttons">
                @if (Model.IsAdmin)
                {
                    <details class="debug-menu">
                        <summary>Debug</summary>
                        <div class="debug-dropdown server-dropdown">
                            <form asp-action="ResetDemo" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                <button type="submit">Ripristina Demo</button>
                            </form>
                            <form asp-action="ClearDemo" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                <button type="submit">Svuota Dati</button>
                            </form>
                        </div>
                    </details>
                    <a class="header-link-button" asp-action="Create" asp-route-returnUrl="@Model.ReturnUrl">Aggiungi Auto</a>
                }
                <a class="header-link-button" asp-controller="Account" asp-action="Logout">Logout</a>
            </div>
        </header>

        <div class="container">
            @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
            {
                <div class="status-box" style="display:block;">@Model.StatusMessage</div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="status-box" data-tone="error" style="display:block;">@Model.ErrorMessage</div>
            }

            <div class="toolbar-note">
                <strong>@Model.TotalCount @(Model.TotalCount == 1 ? "veicolo" : "veicoli")</strong>
            </div>

            <details class="search-panel">
                <summary class="search-summary">Ricerca avanzata</summary>
                <form asp-action="Index" method="get" class="search-grid">
                    <div class="search-field">
                        <label asp-for="Filters.Search">Ricerca</label>
                        <input asp-for="Filters.Search" placeholder="Modello, targa, stato, gruppo, carburante" />
                    </div>
                    <div class="search-field">
                        <label asp-for="Filters.Group">Gruppo</label>
                        <select asp-for="Filters.Group">
                            <option value="">Tutti i gruppi</option>
                            <option value="FONDAZIONE SETTORE-1">FONDAZIONE SETTORE-1</option>
                            <option value="FONDAZIONE SETTORE-2">FONDAZIONE SETTORE-2</option>
                            <option value="FONDAZIONE SETTORE-3">FONDAZIONE SETTORE-3</option>
                        </select>
                    </div>
                    <div class="search-field">
                        <label asp-for="Filters.Status">Stato</label>
                        <select asp-for="Filters.Status">
                            <option value="">Tutti gli stati</option>
                            <option value="non in uso">Non in uso</option>
                            <option value="in uso">In uso</option>
                            <option value="in richiesta manutenzione">In richiesta manutenzione</option>
                            <option value="in manutenzione">In manutenzione</option>
                        </select>
                    </div>
                    <div class="search-field">
                        <label asp-for="Filters.Owner">Assegnatario</label>
                        <input asp-for="Filters.Owner" placeholder="Nome assegnatario" />
                    </div>
                    <div class="search-field">
                        <label asp-for="Filters.FuelLevel">Carburante</label>
                        <select asp-for="Filters.FuelLevel">
                            <option value="">Tutti i livelli</option>
                            <option value="2">Alto</option>
                            <option value="1">Medio</option>
                            <option value="0">Riserva</option>
                        </select>
                    </div>
                    <div class="search-actions">
                        <button type="submit" class="btn-filter">Filtra</button>
                        <a asp-action="Index" class="btn-filter btn-filter-secondary">Pulisci</a>
                    </div>
                </form>
            </details>

            <div class="summary-strip">
                <div class="summary-card"><span>Veicoli visibili</span><strong>@Model.TotalCount</strong></div>
                <div class="summary-card"><span>In uso</span><strong>@Model.InUseCount</strong></div>
                <div class="summary-card"><span>Manutenzione</span><strong>@Model.MaintenanceCount</strong></div>
            </div>

            @if (!Model.Cars.Any())
            {
                <div class="empty-state">Nessun veicolo trovato con i filtri correnti.</div>
            }
            else
            {
                foreach (var group in Model.Cars.GroupBy(car => car.Gruppo))
                {
                    <h3 class="group-header title-@group.Key.ToLowerInvariant().Replace(" ", "-")">@group.Key</h3>

                    <div class="cars-grid">
                        @foreach (var car in group)
                        {
                            <div class="car-card card-@car.Gruppo.ToLowerInvariant().Replace(" ", "-")">
                                <div class="car-image" style="background-image:url('@car.ImageUrl')"></div>
                                <div class="car-info">
                                    <div class="car-model">@car.Modello</div>
                                    <div class="car-brand status-@car.Stato.Replace(" ", "-")">@car.Stato</div>
                                    <div class="car-targa">Targa: @car.Targa</div>
                                    <div class="car-detail"><span>Assegnatario:</span><strong>@(string.IsNullOrWhiteSpace(car.OwnerName) ? "-" : car.OwnerName)</strong></div>
                                    <div class="car-detail"><span>KM:</span><strong>@car.Chilometraggio.ToString("N0", new System.Globalization.CultureInfo("it-IT"))</strong></div>
                                    <div class="car-detail"><span>Carburante:</span><strong>@(car.FuelLevel == 2 ? "Alto" : car.FuelLevel == 1 ? "Medio" : "Riserva")</strong></div>

                                    <details class="card-details">
                                        <summary>Scadenze</summary>
                                        <div class="card-deadlines">
                                            <div><span>Revisione</span><strong>@FormatDates(car.RevisioneInizio, car.RevisioneScadenza)</strong></div>
                                            <div><span>Bollo</span><strong>@FormatDates(car.BolloInizio, car.BolloScadenza)</strong></div>
                                            <div><span>Tagliando</span><strong>@FormatDates(car.TagliandoInizio, car.TagliandoScadenza)</strong></div>
                                            <div><span>Assicurazione</span><strong>@FormatDates(car.AssicurazioneInizio, car.AssicurazioneScadenza)</strong></div>
                                        </div>
                                    </details>

                                    <div class="card-actions">
                                        @if (car.CanUseNow)
                                        {
                                            <form asp-action="UseNow" method="post" class="inline-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@car.Id" />
                                                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                                <button type="submit" class="btn-use-now btn-@car.Gruppo.ToLowerInvariant().Replace(" ", "-")">
                                                    @(car.Stato == "in uso" ? "Smetti di usare" : "Utilizza ora")
                                                </button>
                                            </form>
                                        }

                                        @if (car.CanRequestMaintenance)
                                        {
                                            <form asp-action="RequestMaintenance" method="post" class="inline-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@car.Id" />
                                                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                                <button type="submit" class="btn-secondary-action">Segnala manutenzione</button>
                                            </form>
                                        }

                                        @if (car.CanApproveMaintenance)
                                        {
                                            <form asp-action="ApproveMaintenance" method="post" class="inline-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@car.Id" />
                                                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                                <button type="submit" class="btn-secondary-action">Metti in manutenzione</button>
                                            </form>
                                        }

                                        <a class="btn-edit btn-@car.Gruppo.ToLowerInvariant().Replace(" ", "-")"
                                           asp-action="Edit"
                                           asp-route-id="@car.Id"
                                           asp-route-returnUrl="@Model.ReturnUrl">
                                            @(car.CanEdit ? "Modifica" : "Dettagli")
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
</body>
</html>

@functions {
    private string FormatDates(DateTime? startDate, DateTime? endDate)
    {
        if (!startDate.HasValue && !endDate.HasValue)
        {
            return "-";
        }

        var start = startDate?.ToString("dd/MM/yyyy") ?? "-";
        var end = endDate?.ToString("dd/MM/yyyy") ?? "-";
        return start + " - " + end;
    }
}
