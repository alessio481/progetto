@model FleetManager.Models.ViewModels.LoginUtenteViewModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
    var errori = new List<string>();

    foreach (var voce in ViewData.ModelState.Values)
    {
        foreach (var errore in voce.Errors)
        {
            errori.Add(errore.ErrorMessage);
        }
    }
}
<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fondazione Simonini | Login</title>
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <main id="loginPanel">
        <div class="login-header">
            <img class="login-logo-image" src="https://www.fondazionesimonini.it/imgs/logo.png" alt="Fondazione Simonini">
        </div>

        <form asp-action="Login" method="post" style="width:100%;">
            <input asp-for="Email" placeholder="Email" />
            <input asp-for="Password" type="password" placeholder="Password" />
            <button class="btn-login-custom" type="submit">
                <span class="action-text">Accedi</span>
            </button>
        </form>

        <div class="message-box" data-tone="error">
            @if (errori.Count > 0)
            {
                foreach (var errore in errori)
                {
                    <div>@errore</div>
                }
            }
        </div>

        <div class="login-hint">
            <div class="login-hint-title">
                Credenziali demo
                <span class="login-info-icon"
                      title="Se il database e vuoto, al primo avvio l'app crea il LocalDB e carica automaticamente utenti, password e veicoli demo.">
                    !
                </span>
            </div>
            Demo utente: sara.verdi@fondazionesimonini.it / pass03<br>
            Demo admin: elena.rinaldi@fondazionesimonini.it / admin123
        </div>
    </main>
</body>
</html>
