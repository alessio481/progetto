@model FleetManager.Models.ViewModels.Visualizzatore
@{
    ViewData["Title"] = "Dashboard Driver";
    var me = Model.Utenti.FirstOrDefault();
}

<div class="container mt-4">
    <h2>Dashboard Driver</h2>

    @if (me != null)
    {
        <p class="text-muted">
            Benvenuto, <b>@me.NomeCompleto</b> — <span>Ruolo: <b>@me.Ruolo</b></span>
        </p>
    }

    <div class="row g-3 my-3">
        <div class="col-md-4"><div class="card p-3"><div class="text-muted">Prenotazioni</div><div><b>@Model.Prenotazioni.Count</b></div></div></div>
        <div class="col-md-4"><div class="card p-3"><div class="text-muted">Segnalazioni</div><div><b>@Model.Segnalazioni.Count</b></div></div></div>
        <div class="col-md-4"><div class="card p-3"><div class="text-muted">Manutenzioni</div><div><b>@Model.Manutenzioni.Count</b></div></div></div>
    </div>

    <hr />

    <h4>Prenotazioni (le tue)</h4>
    @if (Model.Prenotazioni.Count == 0)
    {
        <p class="text-muted">Nessuna prenotazione trovata.</p>
    }
    else
    {
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Veicolo</th>
                    <th>Inizio</th>
                    <th>Fine</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Prenotazioni)
                {
                    <tr>
                        <td>@p.Id</td>
                        <td>@(p.Veicolo != null ? $"{p.Veicolo.Marca} {p.Veicolo.Modello} ({p.Veicolo.Targa})" : "-")</td>
                        <td>@p.OraPrenotazione.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@(p.OraRilascio == null ? "Attiva" : p.OraRilascio.Value.ToString("dd/MM/yyyy HH:mm"))</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h4 class="mt-4">Segnalazioni (le tue)</h4>
    @if (Model.Segnalazioni.Count == 0)
    {
        <p class="text-muted">Nessuna segnalazione trovata.</p>
    }
    else
    {
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Veicolo</th>
                    <th>Tipo</th>
                    <th>Stato</th>
                    <th>Data</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Segnalazioni)
                {
                    <tr>
                        <td>@s.SegnalazioneID</td>
                        <td>@(s.Veicolo != null ? s.Veicolo.Targa : "-")</td>
                        <td>@s.Tipo</td>
                        <td>@s.Stato</td>
                        <td>@s.DataCreazione.ToString("dd/MM/yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h4 class="mt-4">Manutenzioni (le tue)</h4>
    @if (Model.Manutenzioni.Count == 0)
    {
        <p class="text-muted">Nessuna manutenzione trovata.</p>
    }
    else
    {
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Veicolo</th>
                    <th>Descrizione</th>
                    <th>Inizio</th>
                    <th>Fine</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.Manutenzioni)
                {
                    <tr>
                        <td>@m.Id</td>
                        <td>@(m.Veicolo != null ? m.Veicolo.Targa : "-")</td>
                        <td>@m.Descrizione</td>
                        <td>@m.DataInizio.ToString("dd/MM/yyyy")</td>
                        <td>@(m.DataFine == null ? "In corso" : m.DataFine.Value.ToString("dd/MM/yyyy"))</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
