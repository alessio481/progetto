@model ErrorViewModel
@{
    ViewData["Title"] = "Errore";
}

<h1>Errore</h1>
<p>Si è verificato un problema durante la richiesta.</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Codice richiesta:</strong> <code>@Model.RequestId</code>
    </p>
}

<p>
    Se stai lavorando in locale, controlla il log del progetto o avvia l'app in ambiente di sviluppo per vedere più dettagli.
</p>
