@model ErroreViewModel
@{
    ViewData["Title"] = "Errore";
}

<h1>Errore</h1>
<p>Si e verificato un problema durante la richiesta.</p>

@if (Model.MostraIdRichiesta)
{
    <p>
        <strong>Codice richiesta:</strong> <code>@Model.IdRichiesta</code>
    </p>
}

<p>
    Se stai lavorando in locale, controlla il log del progetto o avvia l'app in ambiente di sviluppo per vedere piu dettagli.
</p>
